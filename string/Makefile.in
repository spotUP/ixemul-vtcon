#### Start of system configuration section. ####

srcdir =	@srcdir@

ifeq ($(srcdir),.)
srcdir = ../../..
endif

VPATH :=	$(srcdir)

# Common prefix for machine-independent installed files.
prefix =	@prefix@

# Common prefix for machine-dependent installed files.
exec_prefix =	@exec_prefix@

bindir =	$(exec_prefix)/bin
libdir =	$(exec_prefix)/Sys/libs

INSTALL =	@INSTALL@
INSTALL_DATA =	@INSTALL_DATA@

CC =		@CC@

CFLAGS =	@CFLAGS@
LDFLAGS =	@LDFLAGS@

RANLIB =	@RANLIB@
AR = @AR@

#### End system configuration section ####

# I *love* GNU make!
define catenate
printf "creating $@..."
printf '%b' "$(^:%=#include \"%\"\n)" >$@
/bin/echo done
endef

FLAVOR_CFLAGS =	-m$(CPU) -m$(FPU)
INCS =		-I$(srcdir) -I$(srcdir)/../library -I$(srcdir)/../include
# -fno-builtin: these files implement the builtins. gcc 4+ fold a call to
# one into another (bcopy(s, d, n) is memmove(d, s, n)), and memmove.c's
# bcopy() call built with gcc 16 became a jump back to memmove's own entry:
# an endless loop on the first memmove (every program hung). gcc 2.95's
# code is the same with or without it. The loops gcc turns into calls are
# a separate switch: libc_impl.h.
ALL_CFLAGS =	$(CFLAGS) $(FLAVOR_CFLAGS) $(INCS) $(OTHER_CFLAGS) -fno-builtin -g

LIB =		libstring.a

.c.o:
		$(CC) $(ALL_CFLAGS) -c $< -o $@

# all.c includes the sources in this order: sorted, so every build machine
# catenates the same way (make 4.1 returns wildcards in directory order).
SRC =           $(sort $(notdir $(wildcard $(srcdir)/*.c)))
$(LIB) :	all.o
		rm -f $@
		$(AR) rv $@ $^
		$(RANLIB) $@

# libc_impl.h first: no loop may become a call to the function it implements
all.c:		$(SRC) libc_impl.h
		@$(catenate)
		@{ echo '#include "libc_impl.h"'; cat $@; } > $@.tmp && mv $@.tmp $@

clean:
		rm -rf 680?0 notrap

clobber:	clean
		rm -f Makefile
